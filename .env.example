# ─── OAuth (compartilhado desktop + web) ────────────────────────────────────
# Web app (server/): crie um OAuth client tipo "Web application" no Google Cloud
#   Console > Credentials, com redirect URI = OAUTH_REDIRECT_URI abaixo.
# Desktop (.exe legado): usa um client tipo "Desktop". Ambos no mesmo projeto,
#   com tela de consentimento Interna (Workspace Rose) p/ dispensar verificação.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Backend web (server/) ──────────────────────────────────────────────────
# Redirect cadastrado no OAuth client Web. Prod e dev:
#   prod: https://api.revcalc.adventurelabs.com.br/api/auth/callback
#   dev : http://localhost:8000/api/auth/callback
OAUTH_REDIRECT_URI=https://api.revcalc.adventurelabs.com.br/api/auth/callback

# Origem do front (Vercel). Usado p/ CORS e redirect pós-login.
FRONTEND_ORIGIN=https://revcalc.adventurelabs.com.br

# Segredo p/ assinar cookie de sessão + stream token do SSE. Gere com:
#   openssl rand -hex 32
SESSION_SECRET=

# Diretório do token store cifrado (volume do container).
TOKEN_STORE_PATH=/data/tokens

# (opcional) Chave Fernet p/ cifrar o token store. Se ausente, derivada do
# SESSION_SECRET. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# Cookies. Para front e api no mesmo domínio (subdomínios), use:
#   COOKIE_DOMAIN=.adventurelabs.com.br  +  COOKIE_SAMESITE=lax
# Para cross-site (ex.: *.vercel.app × xeon), use SAMESITE=none (sujeito a
# bloqueio de cookie de terceiros — prefira o mesmo domínio).
COOKIE_DOMAIN=.adventurelabs.com.br
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# ─── Feedback (opcional — caixa de feedback do app → Supabase) ──────────────
# Se ausentes, /api/feedback responde 503 e o resto do app funciona normal.
# Inserção em public.revcalc_feedback via PostgREST + service_role (server-side).
# Projeto canônico: ftctmseyrqhckutpfdeq. DDL em db/revcalc_feedback.sql.
#   SUPABASE_URL=https://ftctmseyrqhckutpfdeq.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=        # service_role (NUNCA expor ao browser)
#   REVCALC_FEEDBACK_TABLE=revcalc_feedback

# ─── Drive (opcional — fallback = prod Rose) ────────────────────────────────
# Externalize p/ staging/prod sem editar código.
# REVCALC_PASTA_MAE_ID=
# REVCALC_PASTA_BACEN_ID=
# REVCALC_DOMINIOS_PERMITIDOS=roseportaladvocacia.com.br,adventurelabs.com.br
