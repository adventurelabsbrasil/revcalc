# OAuth Client (Desktop app) criado no Google Cloud Console
# Tela de consentimento: Interno (restringe ao Workspace Rose)
# Tanto client_id quanto client_secret são pareados pelo Google e ambos são
# obrigatórios — o "secret" do Desktop app é embutido em código distribuído
# (não é secret no sentido cripto, é só um identificador pareado).
# Pegar ambos no Google Cloud Console > Credentials > OAuth 2.0 Client IDs
# (botão de download do JSON traz os dois).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
